<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom MAIN manifest. A file at this exact path does not merge into the manifest Unity
    generates: it REPLACES Apk/UnityManifest.xml as the template the Android build patches.
    Selection is by File.Exists alone, so it takes effect even with
    useCustomMainManifest: 0 in ProjectSettings.

    Which is why the body below is Apk/UnityManifest.xml copied verbatim, with one permission
    added. An earlier version of this file declared only the permission; that would have
    deleted the sole declaration of UnityPlayerActivity and of the MAIN/LAUNCHER intent filter
    (Apk/LauncherManifest.xml contains no activity at all), producing an app that installs and
    cannot be started.

    Everything absent here is added by the build, onto the activity below, and must NOT be
    hand-written: resizeableActivity, configChanges, screenOrientation, launchMode and the
    LEANBACK_LAUNCHER category come from the Android build patcher, while AdUnitActivity and
    the AD_ID permission arrive from SDK .aar library manifests through the Gradle merger.

    android.permission.VIBRATE is what AndroidHapticBackend needs: it is required by
    Vibrator.vibrate(long), vibrate(VibrationEffect) and VibrationEffect.createPredefined.
    It is a normal install-time permission, so it costs the player no prompt.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.unity3d.player"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.VIBRATE" />
    <application>
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
                  android:theme="@style/UnityThemeSelector">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
    </application>
</manifest>
